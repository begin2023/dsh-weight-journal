{
  "name": "dsh-weight-journal",
  "version": "1.3.1",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "begin2023"
  },
  "description": "Daily weight journal and weight tracker for the DeepSeek Harness (DSH) Web GUI: a trend-chart page, a sidebar panel, a weight_journal tool, and a multilingual reminder capsule.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "harness",
    "weight",
    "weight-journal",
    "weight-tracker",
    "body-weight",
    "health",
    "fitness",
    "journal",
    "chart",
    "reminder",
    "dashboard"
  ],
  "homepage": "https://github.com/begin2023/dsh-weight-journal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/begin2023/dsh-weight-journal.git"
  },
  "bugs": {
    "url": "https://github.com/begin2023/dsh-weight-journal/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
